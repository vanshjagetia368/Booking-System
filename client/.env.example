# Smart Resource Booking System - Client Environment Configuration
#
# SECURITY NOTICE:
# Variables prefixed with VITE_ are embedded directly into the client-side
# bundle during the build step and are publicly visible to anyone inspecting
# the application in a browser.
# NEVER store passwords, database credentials, JWT secrets, private API keys,
# or other sensitive server secrets in this file.

# Base URL for the Express backend REST API
VITE_API_BASE_URL=http://localhost:5000/api/v1
