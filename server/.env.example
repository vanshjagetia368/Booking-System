# Smart Resource Booking System - Server Environment Configuration
#
# SECURITY INSTRUCTIONS:
# - Copy this file to '.env' in local development: cp .env.example .env
# - NEVER commit real credentials, production passwords, or JWT secrets to Git.
# - The '.env' file is explicitly ignored by .gitignore.
# - NEVER expose database connection strings or JWT secrets to the client frontend.

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Note: Multi-document transaction support for concurrency-safe booking slot allocation
# requires a MongoDB deployment that supports transactions (e.g., a local or remote replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/smart_resource_booking

# Client Application URL (Allowed CORS Origin)
# Matches the local React/Vite development server
CLIENT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Reserved for Future Authentication (Prompt 5)
# Do not activate or implement authentication logic in this foundation stage.
JWT_SECRET=development_jwt_secret_minimum_32_characters_for_future_auth
JWT_EXPIRES_IN=7d
